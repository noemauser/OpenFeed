{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfeed.dev/schemas/venue-message-v0.2.json",
  "title": "OpenFeed Venue Message",
  "type": "object",
  "required": [
    "id",
    "type",
    "from",
    "created_at",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "announce",
        "chat",
        "pack_pointer",
        "query",
        "reply",
        "norm_ping",
        "system"
      ]
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": [
        "string",
        "null"
      ]
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "pack_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
